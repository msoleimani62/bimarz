# Single source of truth for the Xray-core proto API version that BiMarz
# builds against. Every consumer (scripts/fetch-protos.sh,
# scripts/build-release.sh, engine-core/build.rs, CI/release workflows and
# the documentation) reads the pin from this file — never hard-code the
# version anywhere else.
#
# تنها مرجع معتبر برای نسخه‌ی proto API مربوط به Xray-core که بی‌مرز با آن
# ساخته می‌شود. همه‌ی مصرف‌کننده‌ها (scripts/fetch-protos.sh،
# scripts/build-release.sh، engine-core/build.rs، گردش‌کارهای CI/release و
# مستندات) این فایل را می‌خوانند — نسخه را هیچ‌جای دیگر hard-code نکن.

# Git tag of the upstream Xray-core release the proto tree is taken from.
# تگ گیت نسخه‌ی upstream مربوط به Xray-core که درخت proto از آن گرفته می‌شود.
XRAY_PROTO_TAG="v1.8.24"

# Immutable commit that the tag above resolved to when pinned (verified by
# scripts/fetch-protos.sh after cloning, so a re-targeted/moved tag fails
# the build loudly instead of silently changing the proto tree).
# کامیت غیرقابل‌تغییری که تگ بالا هنگام پین‌شدن به آن resolve شده (بعد از
# clone توسط scripts/fetch-protos.sh بررسی می‌شود تا اگر تگ جابه‌جا شده
# باشد، build با خطای واضح متوقف شود به‌جای این‌که بی‌صدا درخت proto عوض شود).
XRAY_PROTO_COMMIT="6baad79f9881ee2cf75bdc825b3e2e92b289477a"

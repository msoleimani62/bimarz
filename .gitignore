# Rust
/target/
**/target/

# Fetched proto files (must be re-fetched per engine-core/proto/README.md)
# Everything under proto/ except this directory's own README.md — the
# fetched tree covers app/, common/, core/, transport/, proxy/, all
# top-level, not just app/+common/.
engine-core/proto/*
!engine-core/proto/README.md

# Compiled PyO3 extension — platform-specific, must never be committed;
# each contributor builds it locally with `maturin develop --release`.
orchestrator/bimarz/_engine_core*.so
orchestrator/bimarz/_engine_core*.pyd

# Editor/tool backup files left over from sed -i.bak or similar
*.bak

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/

# User config / secrets — never commit real server profiles
*.enc.json
xo_state.json

# Editor
*.swp
.idea/

# Gradle build cache — local only, never committed
android/.gradle/
android/app/build/

# Generated by bana build (regenerated from Rust source every build) —
# never commit, they'd drift out of sync with mobile-core/src/lib.rs
android/app/src/main/jniLibs/*/*.so
android/app/src/main/kotlin/**/uniffi/

# Backup files
android/gradle.properties.backup.*
